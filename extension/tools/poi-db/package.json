{
  "name": "roadbook-poi-db",
  "version": "0.1.0",
  "private": true,
  "description": "Build the bundled POI SQLite asset from an OpenStreetMap extract",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:poi-db": "bash build-poi-db.sh",
    "build:poi-db:multi": "bash build-multi-region.sh",
    "build:region": "bash build-region-file.sh",
    "build:regions": "bash build-all-regions.sh",
    "build:seed": "bash build-seed.sh",
    "build:manifest": "tsx build-manifest.ts",
    "gen:regions-json": "tsx regions.ts app-json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
