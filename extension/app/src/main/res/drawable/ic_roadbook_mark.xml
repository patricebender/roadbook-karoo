<!--
  Roadbook mark: the route line with passed waypoints (hollow beads) and the
  highlighted destination pin. Converted from roadbook-mark.svg (viewBox
  "78 50 362 384") by shifting all coordinates by (-78,-50) so the drawable's
  viewport starts at 0,0. The source drop-shadow filter has no VectorDrawable
  equivalent and is dropped — at header size the solid pin reads fine.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="25dp"
    android:viewportWidth="362"
    android:viewportHeight="384">

    <!-- route -->
    <path
        android:pathData="M 22 350 C 90 266 72 214 158 202 S 264 182 302 100"
        android:strokeWidth="14"
        android:strokeLineCap="round">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="384"
                android:endX="308"
                android:endY="19">
                <item android:offset="0" android:color="#FF5E3A" />
                <item android:offset="1" android:color="#FFA24A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- passed waypoints (hollow beads) -->
    <path
        android:pathData="M 54 304 m -11 0 a 11 11 0 1 0 22 0 a 11 11 0 1 0 -22 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5" />
    <path
        android:pathData="M 158 202 m -11 0 a 11 11 0 1 0 22 0 a 11 11 0 1 0 -22 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5" />

    <!-- highlighted destination pin -->
    <path android:pathData="M 302 52 m -34 0 a 34 34 0 1 0 68 0 a 34 34 0 1 0 -68 0">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="302" android:startY="18"
                android:endX="302" android:endY="86">
                <item android:offset="0" android:color="#FF7A45" />
                <item android:offset="1" android:color="#F0421B" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M 278 74 L 302 100 L 326 74 Z" android:fillColor="#F0421B" />
    <path
        android:pathData="M 302 52 m -12.5 0 a 12.5 12.5 0 1 0 25 0 a 12.5 12.5 0 1 0 -25 0"
        android:fillColor="#FFFFFF" />
</vector>
