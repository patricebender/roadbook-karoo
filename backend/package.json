{
  "name": "roadbook-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Roadbook for Karoo — build service: route + config → OSM POIs",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:poi-db": "bash data-pipeline/build-poi-db.sh",
    "test": "node --test --import tsx ./src/**/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/better-sqlite3": "^7.6.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
